# GEMINI_API_KEY: Required for Gemini AI API calls (FitBase AI Concierge).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=your_gemini_api_key

# APP_URL: The URL where this applet is hosted.
APP_URL=http://localhost:3000

# SUPABASE CONFIGURATION (Required for real-world Auth & PostgreSQL Database)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Optional browser-prefixed Supabase keys (falls back to SUPABASE_URL / SUPABASE_ANON_KEY if omitted)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Security secrets for hardware biometric HMAC hashing & turnstile daemon pushes
BIOMETRIC_SALT=replace_with_a_random_secret
HARDWARE_AGENT_KEY=your_hardware_agent_key

# Optional WhatsApp Cloud API / Webhook credentials for automated renewal reminders
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_WEBHOOK_URL=https://your-webhook-url
